{
  "listen": ":8443",
  "public_url": "https://enroll.example.org:8443",
  "tls_cert_file": "/etc/eap-enroll/tls/fullchain.pem",
  "tls_key_file": "/etc/eap-enroll/tls/key.pem",
  "setup_ca_file": "/etc/eap-enroll/tls/ca.pem",
  "device_ca_file": "/etc/eap-enroll/device-ca.pem",
  "wifi_cacerts_file": "/etc/eap-enroll/wifi-cacerts.pem",
  "device_cacerts_file": "/etc/eap-enroll/device-cacerts.pem",
  "database": "/var/lib/eap-enroll/enroll.db",
  "code_ttl": "15m",
  "wifi_ttl": "1440h",
  "device_ttl": "8760h",
  "wifi_profile": {
    "ssid": "Example Net",
    "server_domain": "radius.example.org",
    "server_ca_file": "/etc/eap-enroll/radius-server-ca.pem"
  },
  "openbao": {
    "address": "https://openbao.example.org:8200",
    "ca_file": "/etc/eap-enroll/openbao-ca.pem",
    "role_id_file": "/etc/eap-enroll/role-id",
    "secret_id_file": "/etc/eap-enroll/secret-id",
    "approle_mount": "approle",
    "wifi_mount": "pki-radius",
    "wifi_role": "eap-client",
    "device_mount": "pki-enroll",
    "device_role": "device",
    "kv_mount": "kv",
    "user_groups_path": "apps/freeradius/user-groups"
  }
}
